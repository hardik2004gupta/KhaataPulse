# KhaataPulse — Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://khaatapulse:khaatapulse@localhost:5432/khaatapulse

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production: set to your Vercel deployment URL (e.g. https://khaatapulse.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000

# ── Policy thresholds (CLAUDE.md §25) ────────────────────────────────────────
# All values are configuration-driven — never hardcoded in business logic.
AUTO_ACTION_LIMIT=10000       # INR: actions below this execute automatically
MAX_CONTACTS_7D=3             # maximum contacts per customer per 7 days
CONTACT_COOLDOWN_HOURS=24    # cooldown between contacts (hours)
KILL_SWITCH=false            # set true to block all automated actions

# ── LLM (Phase 2+) ───────────────────────────────────────────────────────────
LLM_API_KEY=
LLM_MODEL=

# ── Simulator ────────────────────────────────────────────────────────────────
DEFAULT_COHORT_SIZE=3000
SIMULATOR_VERSION=v1
